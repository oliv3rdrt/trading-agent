# =============================================================================
# trading-agent .env.example
#
# Copy this file to .env (which is gitignored) and fill in your real values.
# NEVER commit the real .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Trading mode — START with PAPER_TRADING=1.
# Flip to 0 ONLY after verifying the full TV→MCP→broker→fill loop on a demo
# account for at least a week.
# -----------------------------------------------------------------------------
PAPER_TRADING=1

# -----------------------------------------------------------------------------
# Kraken (Phase 1) — get API keys at https://www.kraken.com/u/security/api
# IMPORTANT: when creating the API key, DISABLE the "withdraw funds" permission.
# Claude does not need it. Removing it caps blast radius if the key leaks.
# -----------------------------------------------------------------------------
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# -----------------------------------------------------------------------------
# Forex/CFD broker (Phase 2) — broker choice TBD. Uncomment whichever you pick.
# -----------------------------------------------------------------------------
# Option A — OANDA REST API (recommended for simplicity)
# OANDA_API_TOKEN=
# OANDA_ACCOUNT_ID=
# OANDA_ENVIRONMENT=practice    # "practice" for demo, "live" for real money

# Option B — cTrader Open API (use if staying with IC Markets via cTrader)
# CTRADER_CLIENT_ID=
# CTRADER_CLIENT_SECRET=
# CTRADER_ACCESS_TOKEN=
# CTRADER_ACCOUNT_ID=

# Option C — MetaAPI.cloud (use if staying with IC Markets via MT5; paid ~$15/mo)
# METAAPI_TOKEN=
# METAAPI_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Paths — optional overrides. Defaults shown.
# -----------------------------------------------------------------------------
# RULES_PATH=./rules.json
# AUDIT_LOG_PATH=./audit-log.jsonl
